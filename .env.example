# Optional. Leave blank to use the key saved by `mireye-mcp connect` (~/.config/mireye-mcp/credentials.json).
MIREYE_API_KEY=
# Hard cap on total Mireye spend recorded by this app, in USD.
MAX_SPEND_USD=2.00
PORT=4310
# Mapbox token for drive-time areas (server-side only). MAPBOX_API also works.
MAPBOX_TOKEN=
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
