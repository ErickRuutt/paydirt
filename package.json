{
  "name": "paydirt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/server.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "build": "node scripts/check.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "import:sales": "node --env-file-if-exists=.env scripts/import-sales.js",
    "import:census": "node --env-file-if-exists=.env scripts/import-census.js",
    "fetch:gis": "node scripts/fetch-gis-parcels.js",
    "import:candidates": "node --env-file-if-exists=.env scripts/import-candidates.js",
    "fetch:boundaries": "node scripts/fetch-boundaries.js",
    "fetch:osm": "node scripts/fetch-osm-pois.js",
    "sql": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sql.js",
    "setup:notion": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-notion-feedback.js",
    "feedback:resend": "node --env-file-if-exists=.env scripts/resend-feedback.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@clerk/express": "^2.1.96",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
