{
  "name": "paydirt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/check.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
